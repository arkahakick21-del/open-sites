# Скопируйте этот файл в .env и впишите значения.
# Консольная версия (meeting.py) сама спросит ключи Anthropic и OpenAI, если их нет.

# Ключи моделей (обязательно)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram-бот (bot.py)
# Токен выдаёт @BotFather в Telegram
TELEGRAM_BOT_TOKEN=
# Кому разрешено пользоваться ботом: Telegram ID через запятую.
# Свой ID можно узнать командой /id у бота. Пусто = разрешено всем (опасно для кошелька).
ALLOWED_USERS=

# Необязательно. Модели и число кругов.
CLAUDE_MODEL=claude-opus-5-5
GPT_MODEL=gpt-5
ROUNDS=3
