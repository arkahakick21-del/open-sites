# Скопируйте этот файл в .env и впишите значения.

# --- Обязательно ---

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Anthropic для Claude Code: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Кому разрешён бот: Telegram ID через запятую. Узнать свой ID: команда /id у бота.
# Пусто = бот никого не пускает. У бота есть доступ к командам на сервере, поэтому только свои.
ALLOWED_USERS=

# --- Желательно ---

# Ключ OpenAI для распознавания речи: субтитры и голосовые сообщения.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Instagram (можно позже, инструкция в README) ---

# Долгоживущий токен Instagram API with Instagram Login. Бот сам продлевает его раз в сутки.
IG_ACCESS_TOKEN=
# Необязательно: ID аккаунта Instagram, иначе определяется по токену
IG_USER_ID=

# --- Необязательно ---

# Модель Claude. claude-sonnet-5-5 быстрее и дешевле, claude-opus-5-5 умнее в сложном монтаже
CLAUDE_MODEL=claude-sonnet-5-5
# Предел расходов на одну задачу в долларах. Пусто = без предела.
MAX_TASK_USD=5
# 1 = показывать стоимость каждой задачи в ответе
SHOW_COST=0
# Локальный сервер Telegram Bot API для файлов до 2 ГБ, например http://127.0.0.1:8081
TELEGRAM_API_URL=
